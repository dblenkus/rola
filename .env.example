# Settings for compose.production.yaml: copy this file to .env and fill it
# in. compose.yaml runs without a .env and reads only VITE_PAYPAL_CLIENT_ID
# and VITE_SENTRY_DSN from it.
#
# The Compose files set ROLA_DEBUG, ROLA_TRUST_PROXY and ROLA_POSTGRESQL_HOST,
# and the backend image sets ROLA_MEDIA_ROOT and ROLA_STATIC_ROOT.
# ROLA_POSTGRESQL_NAME, ROLA_POSTGRESQL_USER, ROLA_POSTGRESQL_PORT and
# ROLA_POSTGRESQL_SSLMODE keep their defaults, which match the db service.
# Booleans take true or false; an empty value is an error, so leave unused
# booleans commented out. Compose expands $NAME in unquoted and double-quoted
# values, so put a value that contains $, such as a secret key, in single
# quotes.

# Required in production.
# Every docker compose command run in this directory, cron's included, uses
# the production stack. Leave it out of a development .env.
COMPOSE_FILE=compose.production.yaml
ROLA_SECRET_KEY=
ROLA_POSTGRESQL_PASSWORD=
# Comma-separated host names the site answers to.
ALLOWED_HOSTS=
# The site's absolute http(s) address, used in account email links.
ROLA_FRONTEND_URL=
# The number of proxies in front of Gunicorn: nginx plus the TLS terminator,
# or nginx plus Cloudflare with compose.tunnel.yaml, so 2 either way. The
# login throttle identifies clients by this count. Too low, and every client
# shares one budget, so a single password guesser locks everyone out of the
# API and the Django admin login. Too high, and clients choose their own
# address through X-Forwarded-For.
ROLA_NUM_PROXIES=
# PayPal client id, built into the frontend. Optional in development.
VITE_PAYPAL_CLIENT_ID=
# Sentry DSN for frontend error reports, built into the frontend. Without it
# in development, nothing is reported.
VITE_SENTRY_DSN=

# Optional.
# Gunicorn workers; the image runs 2.
# WEB_CONCURRENCY=2
# Application name in account emails; Rola by default.
# ROLA_APP_NAME=Rola
# Comma-separated origins, besides the site itself, trusted for CSRF checks.
# ROLA_CSRF_TRUSTED_ORIGINS=
# Take the request host from X-Forwarded-Host instead of Host.
# ROLA_USE_X_FORWARDED_HOST=true
# Development only: accept any password.
# ROLA_DISABLE_PASSWORD_VALIDATORS=true

# Mail through Amazon SES over SMTP. Without it, mail is discarded.
# ROLA_USE_SES=true
# Required when ROLA_USE_SES is on:
# ROLA_DEFAULT_FROM_EMAIL=
# ROLA_SES_ACCESS_KEY_ID=
# ROLA_SES_SECRET_ACCESS_KEY=
# Optional with SES; the defaults are SES in eu-west-1 over implicit TLS:
# ROLA_SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
# ROLA_SMTP_PORT=465

# Media and static files in S3 instead of the media and static volumes.
# ROLA_USE_S3=true
# Required when ROLA_USE_S3 is on:
# ROLA_AWS_REGION_NAME=
# ROLA_AWS_MEDIA_STORAGE_BUCKET_NAME=
# ROLA_AWS_STATIC_STORAGE_BUCKET_NAME=
# Optional with S3; without keys, boto3 finds credentials itself:
# ROLA_AWS_ACCESS_KEY_ID=
# ROLA_AWS_SECRET_ACCESS_KEY=
# ROLA_AWS_S3_ENDPOINT_URL=

# A Cloudflare Tunnel instead of a TLS terminator on the server; see
# "Cloudflare Tunnel" in docs/deployment.rst. Replace the COMPOSE_FILE line
# above with this one:
# COMPOSE_FILE=compose.production.yaml:compose.tunnel.yaml
# Required with compose.tunnel.yaml:
# TUNNEL_TOKEN=
